generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  admin
  student
}

enum AdmissionStatus {
  pending
  admitted
  rejected
}

model User {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String          @unique
  full_name        String
  role             UserRole        @default(student)
  is_active        Boolean         @default(true)
  admission_status AdmissionStatus @default(pending)
  skills           String[]        @default([])
  fee_plan         Json?
  created_at       DateTime        @default(now()) @db.Timestamptz()

  profile          StudentProfile?

  @@map("users")
}

model StudentProfile {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String   @unique @db.Uuid
  phone                String?
  address              String?
  guardian_name        String?
  guardian_phone       String?
  skills               String[] @default([])
  match_statistics     Json?    @default("{}")
  total_matches_played Int      @default(0)
  total_runs_scored    Int      @default(0)
  total_wickets_taken  Int      @default(0)
  batting_average      Decimal  @default(0) @db.Decimal
  bowling_average      Decimal  @default(0) @db.Decimal
  created_at           DateTime @default(now()) @db.Timestamptz()

  user                 User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}
